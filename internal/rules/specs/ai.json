      "triggers": [
        {
          "literal": "hf_",
          "caseFold": false
        }
      ],
      "validator": "HuggingFaceToken",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 1,
      "maxLookahead": 36,
      "provenance": {
        "source": "https://huggingface.co/docs/hub/security-tokens",
        "license": "original"
      },
      "fixtures": {
