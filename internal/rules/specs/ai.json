{
  "rules": [
    {
      "id": "anthropic-api-key",
      "name": "Anthropic API key",
      "triggers": [
        {
          "literal": "sk-ant-",
          "caseFold": false
        }
      ],
      "validator": "AnthropicAPIKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 8,
      "maxLookahead": 150,
      "provenance": {
        "source": "https://docs.anthropic.com/en/api/getting-started",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "Authorization: Bearer sk-ant-api03-L6VtNHDzbvOYIs52KThe1DBzYMxIsTnjxqnzKJgS1niDgzJKhy20RHoBqBbuVcPjhcUAwu89LeznSyn2bpa26sQIrfAA",
          "ANTHROPIC_API_KEY=sk-ant-admin01-V9AoHGzkZ5UL5o2kDCaFfewEFjXIn7vunFmrPxZZ28kDnJnDY4XLZ6XJmYO2aYzQMmLdhMAA83LqYzEQa8qbJ",
          "{\"config\": {\"anthropic_api_key\": \"sk-ant-api03-L6VtNHDzbvOYIs52KThe1DBzYMxIsTnjxqnzKJgS1niDgzJKhy20RHoBqBbuVcPjhcUAwu89LeznSyn2bpa26sQIrfAA\"}}"
        ],
        "nomatch": [
          "sk-ant-api03-short",
          "ANTHROPIC_API_KEY=sk-ant-xxxxxxxx…",
          "sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "The zoo increased its risk-ant-eater enclosure budget this year.",
          "ANTHROPIC_API_KEY=sk-ant-api03-jQrK7vN2mPxY8zT5aB6cD9eF1gH4iJ"
        ]
      }
    },
    {
      "id": "openai-project-key",
      "name": "OpenAI project-scoped API key",
      "triggers": [
        {
          "literal": "sk-proj-",
          "caseFold": false
        },
        {
          "literal": "sk-svcacct-",
          "caseFold": false
        },
        {
          "literal": "sk-admin-",
          "caseFold": false
        }
      ],
      "validator": "OpenAIProjectKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 8,
      "maxLookahead": 210,
      "provenance": {
        "source": "https://help.openai.com/en/articles/9186755-managing-your-work-in-the-api-platform-with-projects",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "OPENAI_API_KEY=sk-proj-BVNMKlvU9FzBvWdqOPDZtJVcBIS5TvkvuzSLy8asT3BlbkFJLq83zMskErFlHpuT9KMBRkPgrihZPskJwst1ctDX",
          "Authorization: Bearer sk-svcacct-4zROgBOLNt0ZP9sqaEZXj8WJxMSWeuquxqsQX6zBjK1bJpnvzDHlclD7U6Ro",
          "{\"config\": {\"openai_key\": \"sk-admin-4zROgBOLNt0ZP9sqaEZXj8WJxMSWeuquxqsQX6zBjK1bJpnvzDHlclD7U6Ro\"}}"
        ],
        "nomatch": [
          "sk-proj-0JBJkQfgbsuTgzoeHx6jHkf5g1sKJ2",
          "sk-svcacct-abc$%^&*()",
          "sk-admin-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "The vendor's risk-proj-ection model still relies on legacy tools."
        ]
      }
    },
    {
      "id": "openai-legacy-key",
      "name": "OpenAI legacy API key",
      "triggers": [
        {
          "literal": "sk-",
          "caseFold": false
        }
